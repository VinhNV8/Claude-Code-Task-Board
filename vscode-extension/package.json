{
  "name": "agent-task-board",
  "displayName": "Agent Task Board",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "vinhnguyen",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#4f46e5",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VinhNV8/Claude-Code-Task-Board.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://github.com/VinhNV8/Claude-Code-Task-Board/tree/main/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/VinhNV8/Claude-Code-Task-Board/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "task board",
    "kanban",
    "ai agent",
    "parallel tasks",
    "git worktree",
    "code review"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "agentTaskBoard.open",
        "title": "%command.open%",
        "category": "Agent Task Board",
        "icon": "$(checklist)"
      },
      {
        "command": "agentTaskBoard.addWorkspace",
        "title": "%command.addWorkspace%",
        "category": "Agent Task Board"
      },
      {
        "command": "agentTaskBoard.openSettings",
        "title": "%command.openSettings%",
        "category": "Agent Task Board"
      },
      {
        "command": "agentTaskBoard.openInBrowser",
        "title": "%command.openInBrowser%",
        "category": "Agent Task Board"
      },
      {
        "command": "agentTaskBoard.loginClaude",
        "title": "%command.loginClaude%",
        "category": "Agent Task Board"
      },
      {
        "command": "agentTaskBoard.restartServer",
        "title": "%command.restartServer%",
        "category": "Agent Task Board"
      },
      {
        "command": "agentTaskBoard.showLogs",
        "title": "%command.showLogs%",
        "category": "Agent Task Board"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentTaskBoard",
          "title": "Agent Task Board",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agentTaskBoard": [
        {
          "id": "agentTaskBoard.home",
          "name": "%view.home%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentTaskBoard.home",
        "contents": "%view.home.welcome%"
      }
    ],
    "configuration": {
      "title": "Agent Task Board",
      "properties": {
        "agentTaskBoard.claudePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.claudePath%"
        },
        "agentTaskBoard.idleShutdownMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "markdownDescription": "%config.idleShutdownMinutes%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch-server": "node scripts/build.mjs --skip-web",
    "package": "node scripts/build.mjs && vsce package --no-dependencies",
    "package:no-telegram": "node scripts/build.mjs --no-telegram && vsce package --no-dependencies -o agent-task-board-0.1.0-no-telegram.vsix",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --import tsx \"src/*.test.ts\"",
    "icon": "node scripts/icon.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.10.1",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.21.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
