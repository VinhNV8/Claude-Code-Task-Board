{
  "name": "claude-task-board",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run build && npm run start -w server",
    "typecheck": "npm run typecheck -w server && npx tsc --noEmit -p web",
    "dev:mock": "npm run dev:mock -w web",
    "seed:backlog": "node scripts/seed-backlog.mjs",
    "uat:deploy": "node scripts/uat.mjs deploy",
    "uat:start": "node scripts/uat.mjs start",
    "uat:stop": "node scripts/uat.mjs stop",
    "uat:restart": "node scripts/uat.mjs restart",
    "uat:status": "node scripts/uat.mjs status",
    "uat:logs": "node scripts/uat.mjs logs",
    "uat:copy-db": "node scripts/uat.mjs copy-db"
  },
  "devDependencies": {
    "concurrently": "9.1.0"
  }
}
